@startuml
title Current Wiring (Subpackage Build)

package "Generation" {
  [hack/main.go.tmpl]
  [cmd/provider/*/zz_main.go]
}

package "APIs" {
  [apis/*]
  [v1beta1.ProviderConfig]
}

package "Controllers" {
  [internal/controller/*]
}

package "CRDs" {
  [cluster-scoped MRs]
}

[hack/main.go.tmpl] --> [cmd/provider/*/zz_main.go] : generate
[cmd/provider/*/zz_main.go] --> [apis/*] : AddToScheme
[cmd/provider/*/zz_main.go] --> [internal/controller/*] : Setup_<group>
[internal/controller/*] --> [v1beta1.ProviderConfig] : providerConfigRef

@enduml
